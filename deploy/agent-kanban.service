[Unit]
Description=Agent Kanban Nuxt production server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/projects/agent-kanban
Environment=NODE_ENV=production
Environment=HOST=0.0.0.0
Environment=PORT=3000
Environment=NUXT_TELEMETRY_DISABLED=1
Environment=HOME=/home/ubuntu
Environment=PATH=/home/ubuntu/.bun/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/.local/bin/node .output/server/index.mjs
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
SyslogIdentifier=agent-kanban
LimitNOFILE=65536
# Hardening notes:
# - ProtectSystem=strict and NoNewPrivileges=yes are deliberately NOT set:
#   the service writes into arbitrary project folders under /home and must be
#   able to run `sudo -n systemd-run` for sandboxed task harness units
#   (a no-new-privileges process cannot execute setuid sudo).
# - The per-task harness units apply the strict sandbox (ReadOnlyPaths=/,
#   NoNewPrivileges=yes, PrivateTmp=yes) themselves.
ProtectSystem=full
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
